# ============================================
# DOMINGO ADMIN — environment variables
# New, independent system. Nothing is shared
# with the old business website/admin.
# Copy to .env.local for local development.
# ============================================

# --- Admin login ---
DOMINGO_ADMIN_EMAIL=admin@domingo.in
DOMINGO_ADMIN_PASSWORD=change-me-strong-password
DOMINGO_AUTH_SECRET=generate-a-long-random-secret

# --- Admin domain (used for login redirects) ---
NEXTAUTH_URL=http://localhost:3000

# --- NEW Domingo Google Drive (server-side only) ---
# The full service-account JSON, as a single line.
# Create a NEW service account for Domingo (not the old business one).
DOMINGO_GOOGLE_SERVICE_ACCOUNT_JSON=
# Folder (or Shared Drive folder) where Domingo hero images are stored.
DOMINGO_GOOGLE_DRIVE_FOLDER_ID=

# --- NEW Domingo data store ---
# Mode: "github" (persists to the domingo-admin repo) or "local" (dev file).
DOMINGO_DATA_STORE=local
# Where hero/reservations/reviews live inside the repo.
DOMINGO_DATA_PATH=domingo-data.json
# Repo + branch the data is committed to. Owned by this project.
DOMINGO_DATA_OWNER=shamansuryavamshi
DOMINGO_DATA_REPO=domingo-admin
DOMINGO_DATA_BRANCH=main

# Token with repo ("contents:write") scope to commit data.
# This is a token FOR THE NEW SYSTEM — not the old business token.
DOMINGO_GITHUB_TOKEN=